# Copy to .env and fill secrets before start:
#   cp .env.example .env
#
# Local Nest (`npm run start:dev`): DB_HOST=localhost, DB_PORT=3309
# Docker API in this compose: DOCKER_DB_HOST=mysql (default), DOCKER_DB_PORT=3306
# Server: set DB_HOST to the app MySQL (e.g. new-mysql). NEVER migration-mysql / :3307
# Never set DB_DATABASE=didnegar_new — legacy dump name is blocked as app DB

PORT=3000
NODE_ENV=development
# CORS allows all origins (see main.ts); CORS_ORIGINS is unused.

# Host → published MySQL port (compose: "${DB_PORT}:3306")
DB_HOST=localhost
DB_PORT=3309
DB_USERNAME=didnegar
DB_PASSWORD=didnegar
DB_DATABASE=didnegar


LEGACY_MIGRATED_DB_HOST=didnegar_db
LEGACY_MIGRATED_DB_PORT=3309
LEGACY_MIGRATED_DB_USERNAME=didnegar
LEGACY_MIGRATED_DB_PASSWORD=didnegar
LEGACY_MIGRATED_DB_DATABASE=didnegar

MYSQL_ROOT_PASSWORD=root

JWT_SECRET=replace-with-a-long-random-secret
SEED_ON_STARTUP=false
ACCESS_TOKEN_TTL=12h
# true = Swagger keeps Authorize token in localStorage
SWAGGER_PERSIST_AUTH=false

# Optional local OTP (dev): OTP_STATIC_CODE=123456
# Kavenegar verify/lookup OTP SMS
KAVENEGAR_API_BASE=https://api.kavenegar.com/v1
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verifydidnegar

# Legacy media gallery — SFTP (existing multipart /media/upload endpoint only)
MEDIA_SFTP_HOST=
MEDIA_SFTP_PORT=22
MEDIA_SFTP_USERNAME=
MEDIA_SFTP_PASSWORD=
# Optional: prefer key auth over password
# MEDIA_SFTP_PRIVATE_KEY_PATH=/path/to/id_ed25519
MEDIA_SFTP_ROOT=/var/www
MEDIA_STAGING_ROOT=media/staging
MEDIA_GALLERY_ROOT=media/gallery
MEDIA_PUBLIC_BASE_URL=http://localhost/media
MEDIA_MAX_FILE_BYTES=5242880
MEDIA_DAILY_UPLOAD_QUOTA=50
MEDIA_UPLOAD_RATE_LIMIT=10
MEDIA_UPLOAD_RATE_TTL_MS=60000
MEDIA_PENDING_TTL_HOURS=72
MEDIA_REJECTED_TTL_HOURS=24
MEDIA_CLEANUP_CRON=59 23 * * *
MEDIA_CLEANUP_TZ=Asia/Tehran
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# New direct browser upload flow (SeaweedFS S3 API).
# Do not use 127.0.0.1 here when SeaweedFS runs on another server: the API
# container must reach this HTTPS S3 reverse-proxy hostname.
SEAWEED_S3_ENDPOINT=https://s3.didnegar.net
SEAWEED_S3_REGION=us-east-1
SEAWEED_S3_BUCKET=didnegar-media
SEAWEED_S3_ACCESS_KEY=
SEAWEED_S3_SECRET_KEY=
SEAWEED_S3_UPLOAD_URL_TTL_SECONDS=300
# Public read-only Filer/CDN hostname; it maps /products and /banners to the bucket.
MEDIA_PUBLIC_BASE_URL=https://media.didnegar.net

# Product-linked WordPress media → SeaweedFS physical file migration.
# The controller runs on the Nest server. It logs into both remote servers with
# passwords; keep the real .env file readable only by its deployment user.
WORDPRESS_SSH_HOST=
WORDPRESS_SSH_PORT=22
WORDPRESS_SSH_USERNAME=didnegar
WORDPRESS_SSH_PASSWORD=
WORDPRESS_UPLOADS_ROOT=/home/didnegar/public_html/wp-content/uploads
WORDPRESS_OPTIMIZED_ROOT=/home/didnegar/optimized
WORDPRESS_OPTIMIZER_DIR=/home/didnegar/image-optimizer
WORDPRESS_WEBP_CONCURRENCY=4

FILE_SERVER_SSH_HOST=
FILE_SERVER_SSH_PORT=22
FILE_SERVER_SSH_USERNAME=developer
FILE_SERVER_SSH_PASSWORD=
FILE_SERVER_STAGING_ROOT=/home/developer/didnegar-optimized
FILE_SERVER_SEAWEED_S3_ENDPOINT=http://127.0.0.1:8333

# These are passed only as command arguments on the file server. AWS CLI
# credentials must already be configured for FILE_SERVER_SSH_USERNAME there.
# Used by the legacy WordPress → SeaweedFS file migration only.
SEAWEED_S3_PREFIX=optimized-wordpress

# Deposits / payment gateways
ZARINPAL_CALLBACK_URL=http://localhost:3000/deposits/verify/zarinpal
# تست قبل از فعال‌سازی: ZIBAL_MERCHANT=zibal
ZIBAL_MERCHANT=zibal
ZIBAL_API_BASE=https://gateway.zibal.ir
ZIBAL_START_URL=https://gateway.zibal.ir/start
# فرانت نهایی بعد از کال‌بک (status اینجا استرینگ است، مثل PAYED_ACCEPTED)
ZIBAL_CALLBACK_URL=http://localhost:3001/payment/callback
# false = POST واقعی /v1/request (با merchant بالا) — true فقط mock داخلی
ZIBAL_USE_MOCK=false
LOAN_CALLBACK_URL=http://localhost:3001/payment/callback
# آدرس عمومی همین API تا زیبال به /deposits/callback/zibal بخورد
PUBLIC_API_URL=http://localhost:3000
# Frontend redirects after gateway callback verify
PAYMENT_SUCCESS_REDIRECT_URL=http://localhost:3001/success
PAYMENT_FAILED_REDIRECT_URL=http://localhost:3001/failed
