# Copy to .env and fill secrets before start:
#   cp .env.example .env
#
# Local Nest (`npm run start:dev`): DB_HOST=localhost, DB_PORT=3309
# Docker API in this compose: DOCKER_DB_HOST=mysql (default), DOCKER_DB_PORT=3306
# Server: set DB_HOST to the app MySQL (e.g. new-mysql). NEVER migration-mysql / :3307
# Never set DB_DATABASE=didnegar_new — legacy dump name is blocked as app DB

PORT=3000
NODE_ENV=development
# CORS allows all origins (see main.ts); CORS_ORIGINS is unused.

# Host → published MySQL port (compose: "${DB_PORT}:3306")
DB_HOST=localhost
DB_PORT=3309
DB_USERNAME=didnegar
DB_PASSWORD=didnegar
DB_DATABASE=didnegar


LEGACY_MIGRATED_DB_HOST=didnegar_db
LEGACY_MIGRATED_DB_PORT=3309
LEGACY_MIGRATED_DB_USERNAME=didnegar
LEGACY_MIGRATED_DB_PASSWORD=didnegar
LEGACY_MIGRATED_DB_DATABASE=didnegar

MYSQL_ROOT_PASSWORD=root

JWT_SECRET=replace-with-a-long-random-secret
SEED_ON_STARTUP=false
ACCESS_TOKEN_TTL=12h
# true = Swagger keeps Authorize token in localStorage
SWAGGER_PERSIST_AUTH=false

# Optional local OTP (dev): OTP_STATIC_CODE=123456

# Media gallery — SFTP (when MEDIA_SFTP_HOST is set, uploads go to that host)
MEDIA_SFTP_HOST=
MEDIA_SFTP_PORT=22
MEDIA_SFTP_USERNAME=
MEDIA_SFTP_PASSWORD=
# Optional: prefer key auth over password
# MEDIA_SFTP_PRIVATE_KEY_PATH=/path/to/id_ed25519
MEDIA_SFTP_ROOT=/var/www
MEDIA_STAGING_ROOT=media/staging
MEDIA_GALLERY_ROOT=media/gallery
MEDIA_PUBLIC_BASE_URL=http://localhost/media
MEDIA_MAX_FILE_BYTES=5242880
MEDIA_DAILY_UPLOAD_QUOTA=50
MEDIA_UPLOAD_RATE_LIMIT=10
MEDIA_UPLOAD_RATE_TTL_MS=60000
MEDIA_PENDING_TTL_HOURS=72
MEDIA_REJECTED_TTL_HOURS=24
MEDIA_CLEANUP_CRON=59 23 * * *
MEDIA_CLEANUP_TZ=Asia/Tehran
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
