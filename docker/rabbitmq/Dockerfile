# Dedicated RabbitMQ image for Didnegar.
# The management plugin provides the local-only management UI on port 15672.
FROM rabbitmq:4-management

LABEL org.opencontainers.image.title="didnegar-rabbitmq"
LABEL org.opencontainers.image.description="RabbitMQ broker for Didnegar background jobs"

EXPOSE 5672 15672
